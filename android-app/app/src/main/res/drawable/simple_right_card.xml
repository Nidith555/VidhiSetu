<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/vs_gold" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/vs_gold" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/vs_card" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/vs_border" />
        </shape>
    </item>

</selector>