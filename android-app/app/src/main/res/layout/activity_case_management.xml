<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vs_background">

    <!-- ========================= -->
    <!-- HEADER                    -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:background="@color/vs_navy">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Case Management"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your legal matters"
                android:textColor="@color/vs_nav_inactive"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="CASE"
            android:textColor="@color/vs_gold"
            android:textSize="8sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- CONTENT                   -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Cases"
                android:textColor="@color/vs_primary_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keep track of your legal matters, important details and upcoming dates."
                android:textColor="@color/vs_secondary_text"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp" />


            <!-- ========================= -->
            <!-- ADD CASE                  -->
            <!-- ========================= -->

            <Button
                android:id="@+id/addCaseButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="+  Add New Case"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/primary_button"
                android:layout_marginTop="20dp" />


            <!-- ========================= -->
            <!-- CASES                     -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saved cases"
                android:textColor="@color/vs_primary_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/emptyCasesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You don't have any saved cases yet.\n\nTap Add New Case to create your first case."
                android:textColor="@color/vs_secondary_text"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="24dp" />

            <LinearLayout
                android:id="@+id/casesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>