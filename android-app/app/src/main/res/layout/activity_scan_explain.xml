<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vs_background">

    <!-- ===================================================== -->
    <!-- TOP APP BAR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/vs_navy">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan &amp; Explain"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Understand your documents"
                android:textColor="@color/vs_nav_inactive"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">


            <!-- ================================================= -->
            <!-- INTRODUCTION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explain a legal document"
                android:textColor="@color/vs_primary_text"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Take a photo or choose a document. VidhiSetu will help explain it in simple language."
                android:textColor="@color/vs_secondary_text"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="7dp" />


            <!-- ================================================= -->
            <!-- SELECT DOCUMENT CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/document_input_card"
                android:layout_marginTop="22dp">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:text="📄"
                    android:textSize="30sp"
                    android:background="@drawable/document_icon_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add your document"
                    android:textColor="@color/vs_primary_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capture a document or select an image from your phone"
                    android:textColor="@color/vs_secondary_text"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="5dp" />


                <!-- Camera + Gallery -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <Button
                        android:id="@+id/cameraButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Camera"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:background="@drawable/primary_button" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/galleryButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="File"
                        android:textAllCaps="false"
                        android:textColor="@color/vs_navy"
                        android:textSize="14sp"
                        android:background="@drawable/secondary_button" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- DOCUMENT STATUS -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/documentStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No document selected"
                android:textColor="@color/vs_secondary_text"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="12dp" />


            <!-- ================================================= -->
            <!-- DOCUMENT PREVIEW -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document Preview"
                android:textColor="@color/vs_primary_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/document_preview_background">

                <ImageView
                    android:id="@+id/documentPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Document preview" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="No document selected"
                    android:textColor="@color/vs_secondary_text"
                    android:textSize="13sp" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- EXPLAIN BUTTON -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/explainButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Explain Document"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/primary_button"
                android:layout_marginTop="18dp" />


            <!-- ================================================= -->
            <!-- LOADING -->
            <!-- ================================================= -->

            <ProgressBar
                android:id="@+id/explanationProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="18dp" />


            <!-- ================================================= -->
            <!-- EXPLANATION -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/explanationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explanation"
                android:textColor="@color/vs_primary_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp"
                android:background="@drawable/explanation_card"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VidhiSetu AI"
                    android:textColor="@color/vs_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/explanationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your document explanation will appear here."
                    android:textColor="@color/vs_primary_text"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/listenExplanationButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="🔊  Listen"
                    android:textColor="@color/vs_navy"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/secondary_button"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>