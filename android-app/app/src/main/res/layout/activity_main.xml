<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- ========================= -->
    <!-- SCROLLABLE HOME CONTENT   -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================= -->
            <!-- HEADER                     -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#071D32"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- Top bar -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Profile -->

                    <TextView
                        android:id="@+id/profileIcon"
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="21sp"
                        android:textColor="#071D32"
                        android:background="@drawable/profile_circle" />

                    <!-- Logo -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚖ VidhiSetu"
                            android:textColor="#F4C24F"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LAW MADE ACCESSIBLE"
                            android:textColor="#B9C5D1"
                            android:textSize="8sp"
                            android:letterSpacing="0.15" />

                    </LinearLayout>

                    <!-- Search -->

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="⌕"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp" />

                    <!-- Notification -->

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="♧"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp" />

                </LinearLayout>



                <!-- Greeting -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Hello 👋"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="How can we help you today?"
                    android:textColor="#D2DCE5"
                    android:textSize="17sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- FOUR MAIN ACTIONS         -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="#F7F8FA">

                <!-- Row 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Ask -->

                    <LinearLayout
                        android:id="@+id/askCard"
                        android:layout_width="0dp"
                        android:layout_height="175dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="15dp"
                        android:background="@drawable/card_blue">

                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:gravity="center"
                            android:text="🎙️"
                            android:textSize="32sp"
                            android:background="@drawable/icon_blue" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Ask VidhiSetu"
                            android:textColor="#08294A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Tell us your problem"
                            android:textColor="#50657A"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- Scan -->

                    <LinearLayout
                        android:id="@+id/scanCard"
                        android:layout_width="0dp"
                        android:layout_height="175dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="15dp"
                        android:background="@drawable/card_green">

                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:gravity="center"
                            android:text="📄"
                            android:textSize="31sp"
                            android:background="@drawable/icon_green" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Scan &amp; Explain"
                            android:textColor="#08294A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Understand your documents"
                            android:textColor="#50657A"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Row 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Rights -->

                    <LinearLayout
                        android:id="@+id/rightsCard"
                        android:layout_width="0dp"
                        android:layout_height="175dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="15dp"
                        android:background="@drawable/card_gold">

                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:gravity="center"
                            android:text="⚖️"
                            android:textSize="32sp"
                            android:background="@drawable/icon_gold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Know My Rights"
                            android:textColor="#08294A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Learn about your rights"
                            android:textColor="#50657A"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- Legal Help -->

                    <LinearLayout
                        android:id="@+id/helpCard"
                        android:layout_width="0dp"
                        android:layout_height="175dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="15dp"
                        android:background="@drawable/card_purple">

                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:gravity="center"
                            android:text="👥"
                            android:textSize="31sp"
                            android:background="@drawable/icon_purple" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Get Legal Help"
                            android:textColor="#08294A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Find legal assistance"
                            android:textColor="#50657A"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ========================= -->
                <!-- LEGAL SERVICES            -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Legal Services"
                        android:textColor="#08294A"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/viewAllServices"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All  →"
                        android:textColor="#1764A0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Services -->

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- 1. Legal Guidance -->

                        <TextView
                            android:id="@+id/legalGuidanceCard"
                            android:layout_width="105dp"
                            android:layout_height="105dp"
                            android:gravity="center"
                            android:text="📄&#10;&#10;Legal&#10;Guidance"
                            android:textColor="#163B5B"
                            android:textSize="12sp"
                            android:background="@drawable/service_card"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 2. Document Analysis -->

                        <TextView
                            android:id="@+id/documentAnalysisCard"
                            android:layout_width="105dp"
                            android:layout_height="105dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="📁&#10;&#10;Document&#10;Analysis"
                            android:textColor="#163B5B"
                            android:textSize="12sp"
                            android:background="@drawable/service_card"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 3. Find Relevant Laws -->

                        <TextView
                            android:id="@+id/relevantLawsCard"
                            android:layout_width="105dp"
                            android:layout_height="105dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="🔨&#10;&#10;Find Relevant&#10;Laws"
                            android:textColor="#163B5B"
                            android:textSize="12sp"
                            android:background="@drawable/service_card"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 4. Rights & Schemes -->

                        <TextView
                            android:id="@+id/rightsSchemesCard"
                            android:layout_width="105dp"
                            android:layout_height="105dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="🏛️&#10;&#10;Rights &amp;&#10;Schemes"
                            android:textColor="#163B5B"
                            android:textSize="12sp"
                            android:background="@drawable/service_card"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- ========================= -->
                <!-- LEGAL NEWS                -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Legal News"
                        android:textColor="#08294A"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/viewAllNews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All  →"
                        android:textColor="#1764A0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- News card -->

                <LinearLayout
                    android:id="@+id/newsCard"
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="@drawable/news_card">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="⚖️"
                        android:textSize="30sp"
                        android:background="@drawable/news_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Latest legal developments"
                            android:textColor="#08294A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Important legal updates explained simply"
                            android:textColor="#647689"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Read more →"
                            android:textColor="#1764A0"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ========================= -->
                <!-- YOU ARE NOT ALONE          -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="15dp"
                    android:background="@drawable/support_card">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="💡"
                        android:textSize="27sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="You are not alone"
                            android:textColor="#08294A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="VidhiSetu is here to make law simple and accessible."
                            android:textColor="#50657A"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#1764A0"
                        android:textSize="28sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- BOTTOM NAVIGATION         -->
    <!-- ========================= -->
    <!-- ========================= -->
    <!-- BOTTOM NAVIGATION         -->
    <!-- ========================= -->

    <FrameLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="#071D32"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- HOME -->

            <LinearLayout
                android:id="@+id/homeNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="⌂"
                    android:textColor="#F4C24F"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="Home"
                    android:textColor="#F4C24F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- SERVICES -->

            <LinearLayout
                android:id="@+id/servicesNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="▦"
                    android:textColor="#D0D9E2"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="Services"
                    android:textColor="#D0D9E2"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- CENTER ASK VIDHISETU -->

            <FrameLayout
                android:id="@+id/askNavContainer"
                android:layout_width="100dp"
                android:layout_height="78dp"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/askBottomButton"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="🎙️"
                    android:textSize="27sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/ask_circle"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>


            <!-- RESOURCES -->

            <LinearLayout
                android:id="@+id/resourcesNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="▤"
                    android:textColor="#D0D9E2"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="Resources"
                    android:textColor="#D0D9E2"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- PROFILE -->

            <LinearLayout
                android:id="@+id/profileNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textColor="#D0D9E2"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="Profile"
                    android:textColor="#D0D9E2"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>
</LinearLayout>