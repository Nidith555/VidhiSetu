<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Case Title *"
            android:textColor="@color/vs_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/caseTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="e.g. Property Dispute - Sector 12"
            android:inputType="textCapSentences"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Person / Organization"
            android:textColor="@color/vs_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/casePersonInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Opposite party name"
            android:inputType="textCapWords"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Case Type *"
            android:textColor="@color/vs_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/caseTypeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="e.g. Civil, Criminal, Family"
            android:inputType="textCapWords"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Description *"
            android:textColor="@color/vs_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/caseDescriptionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="top"
            android:hint="Brief overview of the case"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Next Hearing Date"
            android:textColor="@color/vs_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/caseNextDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="DD/MM/YYYY"
            android:inputType="date"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>