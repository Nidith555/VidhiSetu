<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vs_background">


    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/vs_navy">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Legal News"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latest official legal updates"
                android:textColor="@color/vs_nav_inactive"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>


        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Refresh"
            android:tint="@color/vs_gold" />

    </LinearLayout>


    <!-- CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- PAGE DESCRIPTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stay updated with important developments from official legal and government sources."
                android:textColor="@color/vs_secondary_text"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="16dp" />


            <!-- LOADING -->

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading latest legal news..."
                android:textColor="@color/vs_secondary_text"
                android:textSize="15sp"
                android:gravity="center"
                android:padding="30dp" />


            <!-- ERROR -->

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unable to load legal news."
                android:textColor="@color/vs_secondary_text"
                android:textSize="15sp"
                android:gravity="center"
                android:padding="30dp"
                android:visibility="gone" />


            <!-- EMPTY -->

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No legal news available right now."
                android:textColor="@color/vs_secondary_text"
                android:textSize="15sp"
                android:gravity="center"
                android:padding="30dp"
                android:visibility="gone" />


            <!-- DYNAMIC NEWS -->

            <LinearLayout
                android:id="@+id/newsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>


</LinearLayout>