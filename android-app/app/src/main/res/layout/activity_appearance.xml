<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vs_background">

    <!-- ====================================== -->
    <!-- HEADER                                 -->
    <!-- ====================================== -->

    <View
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="@color/vs_navy"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="19dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Appearance"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ====================================== -->
    <!-- MAIN APPEARANCE CARD                   -->
    <!-- ====================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appearanceOption"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/profile_option_card"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Theme icon -->

        <TextView
            android:id="@+id/themeIcon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/service_icon_background"
            android:gravity="center"
            android:text="☾"
            android:textColor="@color/vs_gold"
            android:textSize="26sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Title -->

        <TextView
            android:id="@+id/themeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Dark Mode"
            android:textColor="@color/vs_primary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/themeIcon"
            app:layout_constraintTop_toTopOf="@id/themeIcon"
            app:layout_constraintEnd_toStartOf="@id/darkModeSwitch" />

        <!-- Description -->

        <TextView
            android:id="@+id/themeSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:text="Use a darker appearance throughout VidhiSetu"
            android:textColor="@color/vs_secondary_text"
            android:textSize="9sp"
            app:layout_constraintStart_toEndOf="@id/themeIcon"
            app:layout_constraintTop_toBottomOf="@id/themeTitle"
            app:layout_constraintEnd_toStartOf="@id/darkModeSwitch" />

        <!-- Switch -->

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/darkModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ====================================== -->
    <!-- INFORMATION CARD                      -->
    <!-- ====================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/themeInfoCard"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/profile_option_card"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/appearanceOption"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/themeInfoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Your appearance preference"
            android:textColor="@color/vs_primary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/themeInfoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Your choice is saved on this device and will be remembered the next time you open VidhiSetu."
            android:textColor="@color/vs_secondary_text"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp"
            app:layout_constraintTop_toBottomOf="@id/themeInfoTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>