<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vs_background">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="@color/vs_navy">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Know My Rights"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Legal information in simple language"
                android:textColor="@color/vs_nav_inactive"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Information -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/rightTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Property &amp; Land"
                android:textColor="@color/vs_primary_text"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rightSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Understanding your legal rights"
                android:textColor="@color/vs_secondary_text"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <!-- Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/explanation_card"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR RIGHTS"
                    android:textColor="@color/vs_gold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/rightInformation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Information will appear here."
                    android:textColor="@color/vs_primary_text"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Listen -->
            <TextView
                android:id="@+id/listenButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="🔊  Listen"
                android:textColor="@color/vs_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="18dp" />

            <!-- Disclaimer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/document_input_card"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Important"
                    android:textColor="@color/vs_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/disclaimerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This information is for general understanding. The law applicable to a particular situation depends on the facts and circumstances."
                    android:textColor="@color/vs_secondary_text"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>