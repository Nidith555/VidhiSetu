<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================================================= -->
    <!-- CHAMBER BACKGROUND                                        -->
    <!-- ========================================================= -->

    <ImageView
        android:id="@+id/chamberBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/chamber_image_potrait"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark cinematic overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />


    <!-- ========================================================= -->
    <!-- MAIN UI                                                    -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <!-- ===================================================== -->
        <!-- TOP BAR                                                -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <!-- Back button -->
            <TextView
                android:id="@+id/backButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@android:color/white"
                android:textSize="36sp"
                android:clickable="true"
                android:focusable="true" />


            <!-- VidhiSetu branding -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIDHISETU"
                    android:textColor="#F4C24F"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI LEGAL ASSISTANT"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.10" />

            </LinearLayout>


            <!-- AI status -->
            <LinearLayout
                android:id="@+id/aiStatusContainer"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:background="@drawable/status_chip_background"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#4CAF50"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI CHAMBER COGNITION"
                        android:textColor="#F4C24F"
                        android:textSize="7sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/aiStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE • READY"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- Language -->
            <TextView
                android:id="@+id/languageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="🌐"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- COMPACT CONVERSATION AREA                              -->
        <!-- IMPORTANT: THIS STAYS ABOVE THE CHAIR                  -->
        <!-- ===================================================== -->

        <ScrollView
            android:id="@+id/conversationScroll"
            android:layout_width="match_parent"
            android:layout_height="235dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="2dp"
            android:fillViewport="false"
            android:clipToPadding="true"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:id="@+id/conversationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <!-- ================================================= -->
                <!-- INITIAL AI MESSAGE                                -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="55dp"
                    android:orientation="vertical">

                    <!-- AI name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚖️  VidhiSetu AI"
                        android:textColor="#F4C24F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp" />


                    <!-- AI message -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="360dp"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/ai_message_background"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/welcomeMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tell me what happened. I'll ask a few questions before providing legal guidance."
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>


        <!-- ===================================================== -->
        <!-- SPACE / CHAIR AREA                                     -->
        <!-- The chamber remains visible here                       -->
        <!-- ===================================================== -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <!-- ===================================================== -->
        <!-- QUESTION STATUS                                        -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/questionProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:text="Tell me about your situation"
            android:textColor="#F4C24F"
            android:textSize="11sp"
            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- INPUT BAR                                               -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:padding="5dp"
            android:background="@drawable/input_bar_background"
            android:orientation="horizontal">


            <!-- Text input -->
            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Type your answer..."
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#B8B8B8"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionSend" />


            <!-- Microphone -->
            <TextView
                android:id="@+id/micButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="🎙"
                android:textSize="20sp"
                android:background="@drawable/mic_button"
                android:clickable="true"
                android:focusable="true" />


            <!-- Send -->
            <TextView
                android:id="@+id/sendButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="➤"
                android:textColor="#071D32"
                android:textSize="21sp"
                android:textStyle="bold"
                android:background="@drawable/send_button"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>