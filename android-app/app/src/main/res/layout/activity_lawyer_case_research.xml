<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vs_background">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/vs_navy"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASE RESEARCH"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Legal research workspace"
                android:textColor="@color/vs_nav_inactive"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- CONTENT -->

    <ScrollView
        android:id="@+id/researchScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- CASE TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASE / MATTER"
                android:textColor="@color/vs_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/caseTitleInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/document_input_card"
                android:hint="Enter case or matter title"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/vs_primary_text"
                android:textColorHint="@color/vs_secondary_text"
                android:textSize="13sp" />


            <!-- LEGAL ISSUE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="LEGAL ISSUE"
                android:textColor="@color/vs_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/legalIssueInput"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/document_input_card"
                android:gravity="top"
                android:hint="Describe the legal question or issue"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/vs_primary_text"
                android:textColorHint="@color/vs_secondary_text"
                android:textSize="13sp" />


            <!-- FACTS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="RELEVANT FACTS"
                android:textColor="@color/vs_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/factsInput"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/document_input_card"
                android:gravity="top"
                android:hint="Enter the important facts of the matter"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/vs_primary_text"
                android:textColorHint="@color/vs_secondary_text"
                android:textSize="13sp" />


            <!-- RESEARCH AREA -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="RESEARCH AREA"
                android:textColor="@color/vs_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/researchAreaInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/document_input_card"
                android:gravity="top"
                android:hint="Example: Criminal law, constitutional law, contract law..."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/vs_primary_text"
                android:textColorHint="@color/vs_secondary_text"
                android:textSize="13sp" />


            <!-- ACTIONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Clear"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/startResearchButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:layout_marginStart="6dp"
                    android:text="Start Research"
                    android:textAllCaps="false" />

            </LinearLayout>


            <!-- RESULT -->

            <LinearLayout
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/explanation_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/resultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Research Framework"
                    android:textColor="@color/vs_primary_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/vs_primary_text"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Save Research"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>