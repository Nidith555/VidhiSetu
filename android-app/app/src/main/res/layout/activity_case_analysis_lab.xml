<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vs_background">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/vs_navy"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASE ANALYSIS LAB"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Legal reasoning practice"
                android:textColor="@color/vs_nav_inactive"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- CONTENT -->

    <ScrollView
        android:id="@+id/studentScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- CASE TITLE -->

            <TextView
                android:id="@+id/caseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Case 01"
                android:textColor="@color/vs_primary_text"
                android:textSize="21sp"
                android:textStyle="bold" />


            <!-- CASE FACTS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="CASE FACTS"
                android:textColor="@color/vs_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/caseFacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/simple_right_card"
                android:padding="15dp"
                android:textColor="@color/vs_primary_text"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />


            <!-- QUESTION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="YOUR TASK"
                android:textColor="@color/vs_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/caseQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/explanation_card"
                android:padding="15dp"
                android:textColor="@color/vs_primary_text"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />


            <!-- LEGAL ISSUES -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="1. IDENTIFY THE LEGAL ISSUE"
                android:textColor="@color/vs_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/issuesInput"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/document_input_card"
                android:gravity="top"
                android:hint="What is the main legal issue?"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/vs_primary_text"
                android:textColorHint="@color/vs_secondary_text"
                android:textSize="13sp" />


            <!-- APPLICABLE LAW -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="2. APPLICABLE LAW"
                android:textColor="@color/vs_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/lawsInput"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/document_input_card"
                android:gravity="top"
                android:hint="Mention the relevant Articles, Acts or legal principles."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/vs_primary_text"
                android:textColorHint="@color/vs_secondary_text"
                android:textSize="13sp" />


            <!-- ARGUMENTS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="3. ARGUMENTS OF BOTH SIDES"
                android:textColor="@color/vs_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/argumentsInput"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/document_input_card"
                android:gravity="top"
                android:hint="Explain the arguments of the citizen and the State."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/vs_primary_text"
                android:textColorHint="@color/vs_secondary_text"
                android:textSize="13sp" />


            <!-- CONCLUSION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="4. YOUR CONCLUSION"
                android:textColor="@color/vs_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/conclusionInput"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/document_input_card"
                android:gravity="top"
                android:hint="Give your reasoned legal conclusion."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/vs_primary_text"
                android:textColorHint="@color/vs_secondary_text"
                android:textSize="13sp" />


            <!-- BUTTONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Clear"
                    android:textAllCaps="false"
                    android:textColor="@color/vs_primary_text" />

                <Button
                    android:id="@+id/submitButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:layout_marginStart="6dp"
                    android:text="Submit Analysis"
                    android:textAllCaps="false" />

            </LinearLayout>


            <!-- RESULT -->

            <LinearLayout
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/explanation_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRACTICE RESULT"
                    android:textColor="@color/vs_secondary_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 / 100"
                    android:textColor="@color/vs_primary_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/feedbackText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/vs_primary_text"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <Button
                    android:id="@+id/restartButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Try Again"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>